# Copy to .env.local and fill in local values.

# OpenAI-compatible upstream used for local smoke tests.
LLM_GATEWAY_UPSTREAM_BASE_URL=https://example.com/v1
LLM_GATEWAY_UPSTREAM_MODEL=example-model
LLM_GATEWAY_UPSTREAM_API_KEY=replace-me

# LiteLLM model string for OpenAI-compatible upstreams.
LLM_GATEWAY_LITELLM_MODEL=openai/example-model

# Async service dependencies.
LLM_GATEWAY_DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway@localhost:5432/llm_gateway
LLM_GATEWAY_REDIS_URL=redis://localhost:6379/0
